  <data key="d10">/kaggle/working/reproduce_MegaRAG/MegaRAG/vdoc_tmp/pages_content.json</data>
  <data key="d11">1787637949</data>
</edge>
<edge source="Em đi giữa biển vàng" target="Bùi Đình Thảo">
  <data key="d6">10.0</data>
  <data key="d7">Bài hát 'Em đi giữa biển vàng' do nhạc sĩ Bùi Đình Thảo sáng tác, thể hiện giai điệu đặc trưng của bài hát.</data>
