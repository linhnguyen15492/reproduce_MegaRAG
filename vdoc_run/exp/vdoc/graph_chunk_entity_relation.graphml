</edge>
<edge source="Ngày hội tái chế" target="Lập chậu">
  <data key="d6">9.0</data>
  <data key="d7">Lập chậu là một hoạt động cụ thể trong sự kiện Ngày hội tái chế, nơi học sinh và cộng đồng cùng nhau tạo chậu trồng cây từ rác thải.</data>
  <data key="d8">event_component</data>
  <data key="d9">chunk-9cbd3fde99f09bfc85a43cfc53d9898e</data>
  <data key="d10">/kaggle/working/reproduce_MegaRAG/MegaRAG/vdoc_tmp/pages_content.json</data>
