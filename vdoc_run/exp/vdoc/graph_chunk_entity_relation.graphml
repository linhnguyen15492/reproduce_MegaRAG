  <data key="d1">mathematical_expression</data>
  <data key="d2">Công thức cấu tạo của propanol, một đồng phân vị trí nhóm chức.</data>
  <data key="d3">chunk-234aa0e8ab41f14afa30b5bc24fc3620</data>
  <data key="d4">/kaggle/working/reproduce_MegaRAG/MegaRAG/vdoc_tmp/pages_content.json</data>
  <data key="d5">1787637567</data>
</node>
<node id="CH₂=CH₂">
  <data key="d0">CH₂=CH₂</data>
  <data key="d1">mathematical_expression</data>
  <data key="d2">Công thức phân tử của etilen, một hợp chất không no.</data>
  <data key="d3">chunk-234aa0e8ab41f14afa30b5bc24fc3620</data>
  <data key="d4">/kaggle/working/reproduce_MegaRAG/MegaRAG/vdoc_tmp/pages_content.json</data>
  <data key="d5">1787637570</data>
</node>
<node id="CH₂=CH–CH₃">
  <data key="d0">CH₂=CH–CH₃</data>
  <data key="d1">mathematical_expression</data>
  <data key="d2">Công thức phân tử của propilen, một đồng đẳng của etilen.</data>
  <data key="d3">chunk-234aa0e8ab41f14afa30b5bc24fc3620</data>
  <data key="d4">/kaggle/working/reproduce_MegaRAG/MegaRAG/vdoc_tmp/pages_content.json</data>
