</edge>
<edge source="Chòm sao Gấu Bé" target="Chòm sao Gấu Lớn">
  <data key="d6">8.0</data>
  <data key="d7">Chòm sao Gấu Bé nằm cạnh chòm Gấu Lớn trên bầu trời phương Bắc và có kích thước nhỏ hơn, với các ngôi sao gần nhau hơn.</data>
  <data key="d8">geographical proximity,size comparison</data>
