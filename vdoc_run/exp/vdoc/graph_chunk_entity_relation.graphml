</edge>
<edge source="Bài toán 3a" target="Bài toán 3b">
  <data key="d6">7.0</data>
  <data key="d7">Cả hai đều là bài toán so sánh hai biểu thức số học, nhưng với các phép tính và kết quả khác nhau.</data>
  <data key="d8">logic,so sánh số học</data>
