</edge>
<edge source="Bài toán 2a" target="Bài toán 2b">
  <data key="d6">8.0</data>
  <data key="d7">Cả hai đều là bài toán tìm chữ số thích hợp trong phép tính, nhưng có cấu trúc phép tính khác nhau (cộng và trừ).</data>
  <data key="d8">cùng loại bài tập,phép tính</data>
  <data key="d9">chunk-2dec2e0df2203a994785994b8aa1787b</data>
  <data key="d10">/kaggle/working/reproduce_MegaRAG/MegaRAG/vdoc_tmp/pages_content.json</data>
  <data key="d11">1787637843</data>
</edge>
<edge source="Bài toán 2b" target="Bài toán 2c">
  <data key="d6">8.0</data>
  <data key="d7">Cả hai đều là bài toán tìm chữ số thích hợp trong phép tính, nhưng có cấu trúc phép tính khác nhau (cộng và trừ).</data>
  <data key="d8">cùng loại bài tập,phép tính</data>
  <data key="d9">chunk-2dec2e0df2203a994785994b8aa1787b</data>
