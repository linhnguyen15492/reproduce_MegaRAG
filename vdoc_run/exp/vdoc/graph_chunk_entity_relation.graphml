</edge>
<edge source="Chòm sao Gấu Bé" target="Sao Bắc Cực">
  <data key="d6">9.0</data>
  <data key="d7">Sao Bắc Cực là ngôi sao cuối đuôi của chòm sao Gấu Bé, đóng vai trò quan trọng trong việc xác định hướng Bắc.</data>
  <data key="d8">celestial navigation,directional reference</data>
